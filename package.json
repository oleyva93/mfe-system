{
  "name": "mfe-system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:native": "turbo run dev -F native --",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@mfe-system/env": "*",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@mfe-system/config": "*",
    "@types/node": "^26.2.0",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "esbuild": true
  }
}
