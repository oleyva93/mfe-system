{
  "expo": {
    "name": "MFE",
    "slug": "mfe-system",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mfe-system",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#141416",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.mfe-system",
      "backgroundColor": "#141416"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mfesystem",
      "backgroundColor": "#141416"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#141416"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#141416",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#141416"
          },
          "ios": {
            "backgroundColor": "#141416",
            "dark": {
              "backgroundColor": "#141416"
            }
          },
          "android": {
            "backgroundColor": "#141416",
            "dark": {
              "backgroundColor": "#141416"
            }
          }
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6fe462c4-a49e-4976-9ea1-9506029c9527",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6fe462c4-a49e-4976-9ea1-9506029c9527"
      }
    },
    "owner": "oleyva93"
  }
}
